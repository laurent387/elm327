# ~/.config/overmind/obd.env — chargé par les unités systemd utilisateur overmind-obd-*
OVERMIND_OBD_DB=/home/VOTRE_UTILISATEUR/.local/share/overmind/obd.sqlite3
OVERMIND_OBD_REGISTRY=/home/VOTRE_UTILISATEUR/.config/overmind/obd_gateways.yaml
OVERMIND_OBD_MQTT_HOST=127.0.0.1
OVERMIND_OBD_MQTT_PORT=1883
OVERMIND_OBD_MQTT_USER=overmind-ingest
OVERMIND_OBD_MQTT_PASSWORD=change-me
OVERMIND_OBD_LOST_AFTER_S=30
OVERMIND_OBD_API_HOST=127.0.0.1
OVERMIND_OBD_API_PORT=8095
OVERMIND_OBD_MCP_HOST=127.0.0.1
OVERMIND_OBD_MCP_PORT=8799   # 8796 est pris par truvision_yolo sur le GE75
# Copilote « Kitt » (overmind-copilot.service)
OVERMIND_COPILOT_NAME=Kitt
OVERMIND_COPILOT_PORT=8097
# Télécommande MCP (127.0.0.1 uniquement ; 0 = désactivée ; éteinte tant qu'aucun jeton de portée « remote »)
OVERMIND_COPILOT_MCP_PORT=8789
# Adresse(s) réseau en plus de 127.0.0.1 (cible de la redirection Freebox), jamais 0.0.0.0 ; TLS obligatoire
OVERMIND_COPILOT_HOSTS=192.168.1.35
OVERMIND_COPILOT_TLS_CERT=/home/VOTRE_UTILISATEUR/.config/overmind/ca/server.crt
OVERMIND_COPILOT_TLS_KEY=/home/VOTRE_UTILISATEUR/.config/overmind/ca/server.key
# OVERMIND_COPILOT_VOSK_MODEL=/home/VOTRE_UTILISATEUR/.local/share/overmind/models/vosk/vosk-model-fr-0.22
