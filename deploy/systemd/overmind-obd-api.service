[Unit]
Description=Overmind OBD — API, WebSocket temps réel et ingestion MQTT embarquée (:8095)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/elm327/overmind
EnvironmentFile=%h/.config/overmind/obd.env
ExecStart=%h/elm327/overmind/.venv/bin/python -m overmind_obd.api
Restart=on-failure
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=default.target
