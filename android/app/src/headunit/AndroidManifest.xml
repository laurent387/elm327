<?xml version="1.0" encoding="utf-8"?>
<!-- Variante autoradio : ajoute le copilote vocal « Kitt » à la passerelle OBD (src/main). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Mot de réveil hors ligne, puis énoncé envoyé à Overmind -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Contexte (position) et actions autoradio (appel avec confirmation vocale) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Télécommande Overmind : mise à jour de l'APK, toujours confirmée sur l'écran par l'installeur -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-feature android:name="android.hardware.microphone" android:required="true" />

    <!-- Télécommande : liste des applis lançables (headunit_list_apps / launch_app) -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <application>
        <!-- L'écran passerelle reste accessible depuis Kitt, mais n'est plus le lanceur. -->
        <activity android:name="com.overmind.obdgateway.MainActivity" tools:node="merge">
            <intent-filter tools:node="removeAll" />
        </activity>

        <activity
            android:name="com.overmind.copilot.CopilotActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Overmind">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Bouton « assistant » du volant / de l'autoradio, si le modèle le transmet -->
            <intent-filter>
                <action android:name="android.intent.action.VOICE_COMMAND" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <receiver
            android:name="com.overmind.copilot.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_paths" />
        </provider>

        <service
            android:name="com.overmind.copilot.CopilotService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
    </application>
</manifest>
